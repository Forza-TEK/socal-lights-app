/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

# The site's own CSS and JS change often and there's no build step or file hashing, so make browsers
# check for a new version on every load (a cheap 304 when nothing changed) instead of holding them for hours
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex
