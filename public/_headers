/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://tiles.openfreemap.org https://nominatim.openstreetmap.org https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://player.vimeo.com iframe.videodelivery.net https://*.cloudflarestream.com; object-src 'none'; base-uri 'self'; form-action 'self' checkout.stripe.com; frame-ancestors 'self'

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/add-contest
  X-Robots-Tag: noindex
/c/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
/contest*
  X-Robots-Tag: noindex
/sponsor-invite*
  X-Robots-Tag: noindex, nofollow
/s/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/organizer*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/ad-assets/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

/es
  X-Robots-Tag: noindex
