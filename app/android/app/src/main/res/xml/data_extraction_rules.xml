<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): the app keeps nothing worth backing up (it loads the website), so exclude everything from cloud backup and device-to-device transfer. Older versions use android:fullBackupContent="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
